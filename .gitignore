# OS files
*.DS_Store
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Quarto output. README.html, NOTES.html and their _files directories are
# rendered from the .md sources beside them - `quarto render` reproduces any of
# them - so they are build output, not source.
#
# Tracking them costs a copy of the rendered page that drifts from its source
# the moment the .md is edited, plus 888 KB of vendored Bootstrap and
# clipboard.js per _files directory, rewritten in full on every render.
#
# The .md files are the ones to read and the ones that are versioned.
*.html
*_files/

# The dashboard front end is the exception: under 09_dashboard/site/ the HTML
# is source, not output - it is the page itself, not a render of a .md beside
# it. Without this negation the rule above would silently skip any page added
# there.
!/00_wxdash_2.0/09_dashboard/site/*.html

# The built dashboard. 09 regenerates it in seconds from 09_dashboard/data/,
# so it is output, not source — unlike site/, which is the hand-edited front
# end it is built from. Only a clone without WXDASH_LOCAL writes here; with one
# the site goes to outputs/09_site/, outside the repo like every other output.
/00_wxdash_2.0/09_dashboard/_site/
